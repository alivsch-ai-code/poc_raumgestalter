# Kopiere diese Datei nach ".env" und trage deinen Schlüssel ein.
# Ohne Schlüssel läuft die App im Demo-Modus (Vorlagen, 3D, Fliesen, einfacher Chat).

# API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modell für Plan-Erkennung (Bild -> Raum). Muss Bilder verstehen können.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: anderes Modell nur für den Chat-Assistenten (schneller/günstiger)
# CLAUDE_MODEL_CHAT=claude-haiku-5-5

# Server
HOST=127.0.0.1
PORT=5057
